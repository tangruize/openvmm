 // function body, to enable seamless use of unverified call to the function in
 // verification.
 // If the function is const, it will be rewritten to a proxy function and a verified function.
+/// For a trait method declared with ghost inputs (`with`): writes the method
+/// itself, unchanged and without specification (for unverified callers and
+/// for unverified uses of the trait), to `new_stream`, and returns the method
+/// renamed to the verified copy (`_VERUS_VERIFIED_<name>`), which gets the
+/// ghost inputs and the specification. Verified callers call the verified copy
+/// (`proof_with!` renames the call).
+fn split_trait_method_with(
+    method: syn::TraitItemFn,
+    spec_attr: &verus_syn::SignatureSpecAttr,
+    new_stream: &mut TokenStream,
+) -> syn::TraitItemFn {
+    let span = spec_attr.spec.with.as_ref().unwrap().with.span();
+    method.to_tokens(new_stream);
+    let mut verified = method;
+    let x = &verified.sig.ident;
+    verified.sig.ident = syn::Ident::new(&format!("{VERIFIED}_{x}"), x.span());
+    verified.attrs.push(crate::syntax::mk_rust_attr_syn(span, "allow", quote! {non_snake_case}));
+    if !crate::rustdoc::env_rustdoc() {
+        verified.attrs.push(crate::syntax::mk_rust_attr_syn(span, "doc", quote! {hidden}));
+    }
+    verified
+}
