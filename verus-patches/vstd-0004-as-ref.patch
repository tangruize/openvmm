+
+    open spec fn as_ref_spec(&self) -> &Path {
+        path_buf_as_path(self)
+    }
+}
+
+pub assume_specification<'a>[ <PathBuf as AsRef<Path>>::as_ref ](p: &'a PathBuf) -> (ret: &'a Path)
