@@ -1063,3 +1063,122 @@ test_verify_one_file! {
         }
     } => Err(err) => assert_rust_error_msg(err, "overflow evaluating the requirement")
 }
+
+test_verify_one_file! {
+    // A trait whose supertrait bound names its own associated type
+    // (`trait P: Enc<E = <Self as P>::E>`, as mesh_protobuf's `Protobuf`).
+    // The proxy can only name its own associated type
+    // (`<Self as ExP>::E`; naming `<Self as P>::E` overflows rustc), which
+    // must match the external trait's bound.
+    #[test] external_trait_bound_names_own_assoc_type verus_code! {
+        use vstd::prelude::*;
+
+        #[verifier::external]
+        pub trait Enc { type E; }
+
+        #[verifier::external]
+        pub trait P: Enc<E = <Self as P>::E> + Sized { type E; }
+
+        #[verifier::external]
+        impl<T: Enc> P for T { type E = <T as Enc>::E; }
+
+        #[verifier::external_trait_specification]
+        pub trait ExEnc {
+            type ExternalTraitSpecificationFor: Enc;
+            type E;
+        }
+
+        #[verifier::external_trait_specification]
+        pub trait ExP: Enc<E = <Self as ExP>::E> + Sized {
+            type ExternalTraitSpecificationFor: P;
+            type E;
+        }
+
+        fn uses_p<T: P>(t: T) -> (r: T)
+            ensures r == t,
+        {
+            t
+        }
+    } => Ok(())
+}
+
+test_verify_one_file! {
+    // An external trait impl whose associated type is bounded by a
+    // higher-ranked trait bound (`type C: for<'a> D<'a, Self>`, as
+    // mesh_protobuf's `Protobuf::Encoding`). Verus looks up the impl
+    // satisfying each bound; the bound's late-bound region must not escape.
+    #[test] external_trait_impl_assoc_type_higher_ranked_bound verus_code! {
+        use vstd::prelude::*;
+
+        #[verifier::external]
+        pub trait D<'a, T> {}
+
+        #[verifier::external]
+        pub trait H: Sized { type C: for<'a> D<'a, Self>; }
+
+        pub struct S;
+        pub struct Codec;
+
+        #[verifier::external]
+        impl<'a, T> D<'a, T> for Codec {}
+
+        #[verifier::external]
+        impl H for S { type C = Codec; }
+
+        #[verifier::external_trait_specification]
+        pub trait ExD<'a, T> {
+            type ExternalTraitSpecificationFor: D<'a, T>;
+        }
+
+        #[verifier::external_trait_specification]
+        pub trait ExH: Sized {
+            type ExternalTraitSpecificationFor: H;
+            type C: for<'a> D<'a, Self>;
+        }
+
+        fn uses_h<T: H>(t: T) -> (r: T)
+            ensures r == t,
+        {
+            t
+        }
+
+        fn test() {
+            let s = uses_h(S);
+        }
+    } => Ok(())
+}
+
+test_verify_one_file! {
+    // A declared external trait's bound names a type that is not declared to
+    // Verus (as mesh_protobuf's `NoResources`). This used to panic in
+    // `vir::recursive_types`; it is now an error.
+    #[test] external_trait_bound_names_undeclared_type verus_code! {
+        use vstd::prelude::*;
+
+        #[verifier::external]
+        pub enum NoRes {}
+
+        #[verifier::external]
+        pub trait M<T, R> {}
+
+        #[verifier::external]
+        pub trait Q: Sized { type C: M<Self, NoRes>; }
+
+        #[verifier::external_trait_specification]
+        pub trait ExM<T, R> {
+            type ExternalTraitSpecificationFor: M<T, R>;
+        }
+
+        #[verifier::external_trait_specification]
+        pub trait ExQ: Sized {
+            type ExternalTraitSpecificationFor: Q;
+            type C: M<Self, NoRes>;
+        }
+
+        fn uses_q<T: Q>(t: T) -> (r: T)
+            ensures r == t,
+        {
+            t
+        }
+    } => Err(err) => assert_vir_error_msg(err, "is used but not declared to Verus")
+}
