+/// Replaces projections onto a proxy trait's associated types with
+/// projections onto the external trait's (see `external_trait_specification`).
+struct ProxyAssocToExternal<'tcx> {
+    tcx: TyCtxt<'tcx>,
+    /// Proxy associated type to the external trait's of the same name.
+    map: HashMap<DefId, DefId>,
+}
+
+impl<'tcx> rustc_middle::ty::TypeFolder<TyCtxt<'tcx>> for ProxyAssocToExternal<'tcx> {
+    fn cx(&self) -> TyCtxt<'tcx> {
+        self.tcx
+    }
+
+    fn fold_ty(&mut self, t: rustc_middle::ty::Ty<'tcx>) -> rustc_middle::ty::Ty<'tcx> {
+        use rustc_middle::ty::{TypeFoldable, TypeSuperFoldable};
+        if let rustc_middle::ty::TyKind::Alias(is_rigid, alias) = *t.kind() {
+            if let rustc_middle::ty::AliasTyKind::Projection { def_id } = alias.kind {
+                if let Some(ex_def_id) = self.map.get(&def_id).copied() {
+                    let args = alias.args.fold_with(self);
+                    return rustc_middle::ty::Ty::new_projection_from_args(
+                        self.tcx, is_rigid, ex_def_id, args,
+                    );
+                }
+            }
+        }
+        t.super_fold_with(self)
+    }
+}
