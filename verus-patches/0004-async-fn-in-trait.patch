+
+        trait Counter {
+            spec fn value(&self) -> u64;
+
+            async fn bump(&mut self) -> (r: u64)
+                requires old(self).value() < 100,
+                ensures final(self).value() == old(self).value() + 1, r == final(self).value();
+        }
+
+        struct C { n: u64 }
+
