+/// The name of an associated item. An RPITIT associated type (the hidden
+/// type rustc creates for a trait method's `impl Trait` return type, such as
+/// an `async fn`'s future) has no name; it gets a synthetic one from its
+/// method, the same in the trait and in each impl:
+/// `VERUS_RPITIT__<method>` (or `VERUS_RPITIT<i>__<method>` for the method's
+/// `i`-th such type, `i > 0`).
+pub(crate) fn assoc_item_name<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    item: &rustc_middle::ty::AssocItem,
+) -> String {
+    if let Some(name) = item.opt_name() {
+        return name.to_string();
+    }
+    // An impl's RPITIT type is named after the trait's.
+    let trait_item_def_id = item.trait_item_def_id().unwrap_or(item.def_id);
+    let fn_def_id = match tcx.opt_rpitit_info(trait_item_def_id) {
+        Some(rustc_middle::ty::ImplTraitInTraitData::Trait { fn_def_id, .. }) => fn_def_id,
+        _ => panic!("unnamed associated item that is not an RPITIT type"),
+    };
+    let index = tcx
+        .associated_types_for_impl_traits_in_associated_fn(fn_def_id)
+        .iter()
+        .position(|def_id| *def_id == trait_item_def_id)
+        .expect("RPITIT type of its method");
+    let method = tcx.item_name(fn_def_id);
+    // A valid Rust identifier: Verus writes traits out as Rust code (for its
+    // trait-conflict and lifetime checks).
+    if index == 0 { format!("VERUS_RPITIT__{method}") } else { format!("VERUS_RPITIT{index}__{method}") }
+}
