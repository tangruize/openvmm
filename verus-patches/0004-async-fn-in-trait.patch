+/// An RPITIT associated type (see `rust_to_vir_base::assoc_item_name`): the
+/// hidden type of a method's `impl Trait` / `async fn` return. It is left out
+/// of the model: impls give it the method's opaque type, which the model
+/// cannot express and which cannot make impls conflict.
+fn is_rpitit_assoc_typ(name: &Ident) -> bool {
+    name.starts_with("VERUS_RPITIT")
+}
+
+/// The bounds that are not about an RPITIT associated type.
+fn bounds_without_rpitit(bounds: &GenericBounds) -> GenericBounds {
+    Arc::new(
+        bounds
+            .iter()
+            .filter(|b| {
+                let typs = match &***b {
+                    GenericBoundX::Trait(_, typs) => typs,
+                    GenericBoundX::TypEquality(_, typs, _, _) => typs,
+                    _ => return true,
+                };
+                !matches!(typs.first().map(|t| &**t),
+                    Some(vir::ast::TypX::Projection { name, .. }) if is_rpitit_assoc_typ(name))
+            })
+            .cloned()
+            .collect(),
+    )
+}
