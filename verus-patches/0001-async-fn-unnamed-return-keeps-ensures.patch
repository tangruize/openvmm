+
+test_verify_one_file! {
+    #[test] test_async_function_mut_ref_unnamed_return_ok verus_code! {
+        use vstd::prelude::*;
+        // No named return: the `final(x)` postcondition must still be
+        // available to the caller after `.await`.
+        async fn set_zero(x: &mut usize)
+            ensures *final(x) == 0,
+        {
+            *x = 0;
+        }
+
+        async fn foo() {
+            let mut x = 233;
+            set_zero(&mut x).await;
+            assert(x == 0);
+        }
+    } => Ok(())
+}
+
+test_verify_one_file! {
+    #[test] test_async_method_mut_self_unnamed_return_ok verus_code! {
+        use vstd::prelude::*;
+        struct S { x: u64 }
+
+        impl S {
+            async fn set(&mut self)
+                ensures final(self).x == 7,
+            {
+                self.x = 7;
+            }
+        }
+
+        #[verifier::exec_allows_no_decreases_clause]
+        async fn foo() {
+            let mut s = S { x: 7 };
+            loop
+                invariant s.x == 7,
+            {
+                s.set().await;
+            }
+        }
+    } => Ok(())
+}
+
+test_verify_one_file! {
+    #[test] test_async_function_unnamed_non_unit_return_ok verus_code! {
+        use vstd::prelude::*;
+        async fn bump(x: &mut u64) -> u64
+            requires *old(x) < 100,
+            ensures *final(x) == *old(x) + 1,
+        {
+            *x = *x + 1;
+            5
+        }
+
+        async fn foo() {
+            let mut x = 1;
+            let r = bump(&mut x).await;
+            assert(x == 2);
+        }
+    } => Ok(())
+}
