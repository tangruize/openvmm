+/// The `Output` type of an async function's opaque return type
+/// (`impl Future<Output = T>`), if it can be found.
+fn async_fn_output_typ<'tcx>(
+    ctxt: &Context<'tcx>,
+    id: DefId,
+    span: Span,
+    output_ty: rustc_middle::ty::Ty<'tcx>,
+) -> Result<Option<Typ>, VirErr> {
+    let tcx = ctxt.tcx;
+    let rustc_middle::ty::TyKind::Alias(_, al_ty) = output_ty.kind() else {
+        return Ok(None);
+    };
+    let rustc_middle::ty::AliasTyKind::Opaque { def_id } = al_ty.kind else {
+        return Ok(None);
+    };
+    let Some(future_output) = tcx.lang_items().future_output() else {
+        return Ok(None);
+    };
+    for (clause, _) in tcx.explicit_item_bounds(def_id).skip_binder() {
+        if let rustc_middle::ty::ClauseKind::Projection(pred) = clause.kind().skip_binder() {
+            if pred.projection_term.expect_projection_def_id() == future_output {
+                if let Some(ty) = pred.term.as_type() {
+                    return Ok(Some(ctxt.mid_ty_to_vir(id, span, &ty, None)?));
+                }
+            }
+        }
+    }
+    Ok(None)
+}
