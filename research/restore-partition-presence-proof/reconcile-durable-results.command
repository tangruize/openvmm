/home/ruize/openvmm-restore-v1/.argus-runtime/bin/python -c $'import json; from pathlib import Path; root=Path(".argus_subagents"); ledger=json.loads(Path("research/PIPELINE_STATE.json").read_text()); pairs=(("restore-partition-presence-proposal-check","restore_partition_presence_proposal_check"),("restore-partition-presence-proposal-body","restore_partition_presence_proposal_body"),("restore-partition-presence-proposal-reference","restore_partition_presence_proposal_reference"),("restore-partition-presence-native-syntax","restore_partition_presence_native_syntax"),("restore-partition-presence-integration","restore_partition_presence_integration"));\nfor task,key in pairs:\n receipt=json.loads((root/(task+".json")).read_text()); assert ledger[key]["run_id"]==receipt["run_id"]; assert ledger[key]["state"]==receipt["state"]; stdout=Path(receipt["stdout_log"]).read_text(); stderr=Path(receipt["stderr_log"]).read_text(); assert not stderr; assert "exit="+str(receipt["exit_code"]) in stdout; print(task,receipt["state"],receipt["exit_code"],receipt["elapsed_seconds"],"seconds; stdout and stderr inspected")' 
