/home/ruize/openvmm-restore-v1/.argus-runtime/bin/python -c import\ json\,\ subprocess\;\ from\ pathlib\ import\ Path\;\ m=json.loads\(subprocess.check_output\(\[\"cargo\"\,\"metadata\"\,\"--format-version\"\,\"1\"\,\"--no-deps\"\]\)\)\;\ \[\(print\(json.dumps\(\{k:p\[k\]\ for\ k\ in\ \(\"id\"\,\"manifest_path\"\,\"metadata\"\)\}\)\)\,print\(\"workspace_member\"\,p\[\"id\"\]\ in\ m\[\"workspace_members\"\]\)\)\ for\ p\ in\ m\[\"packages\"\]\ if\ p\[\"name\"\]==\"anyhow\"\]\;\ print\(\"Native\ VIR\ artifacts:\"\)\;\ \[print\(p\)\ for\ p\ in\ Path\(\"target/verus-partial/debug/deps\"\).glob\(\"libanyhow-\*.vir\"\)\] 
