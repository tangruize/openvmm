/home/ruize/openvmm-restore-v1/.argus-runtime/bin/python -c import\ subprocess\,tomllib\;\ from\ pathlib\ import\ Path\;\ files=subprocess.check_output\(\[\"git\"\,\"diff\"\,\"--name-only\"\]\,text=True\).splitlines\(\)\;\ packages=set\(\)\;\ \[packages.add\(tomllib.loads\(next\(parent/\"Cargo.toml\"\ for\ parent\ in\ \[Path\(f\).parent\,\*Path\(f\).parents\]\ if\ \(parent/\"Cargo.toml\"\).exists\(\)\).read_text\(\)\)\[\"package\"\]\[\"name\"\]\)\ for\ f\ in\ files\ if\ f.endswith\(\".rs\"\)\ or\ f.endswith\(\"/Cargo.toml\"\)\]\;\ print\(\"\\n\".join\(sorted\(packages\)\)\) 
