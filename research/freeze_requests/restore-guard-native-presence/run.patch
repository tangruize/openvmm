+    } else if TypeId::of::<E>() == target {
+        let unerased_ref = e.cast::<ErrorImpl<ContextError<C, E>>>();
+        let unerased = unsafe { unerased_ref.deref() };
+        Some(Ref::new(&unerased._object.error).cast::<()>())
+    } else {
+        None
+    }
