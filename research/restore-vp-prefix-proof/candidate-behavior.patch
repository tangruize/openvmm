+    #[test]
+    fn named_closures_validate_dormant_entries_and_preserve_error_order() {
+        struct Payload(u32, std::rc::Rc<std::cell::RefCell<Vec<u32>>>);
+        impl Drop for Payload {
+            fn drop(&mut self) {
+                self.1.borrow_mut().push(self.0);
+            }
+        }
+        for (indices, message) in [
+            (vec![2, 2, 4, 0], "snapshot contains duplicate state for vp2"),
+            (vec![4, 2, 2, 0], "unknown entry id: vp4"),
+            (vec![2, 0], "snapshot is missing state for vp1"),
+        ] {
+            let drops = std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
+            let states = indices.iter()
+                .map(|id| (VpIndex::new(*id), Payload(*id, drops.clone())))
+                .collect();
+            let result = select_instantiated_vp_states(3, 1, states);
+            let error = match result {
+                Err(error) => error,
+                Ok(_) => panic!("invalid full inventory was accepted"),
+            };
+            let details = match &error {
+                RestoreError::InvalidSavedState(source) => source.to_string(),
+                RestoreError::UnknownEntryId(_) => error.to_string(),
+                _ => panic!("unexpected restore error: {error}"),
+            };
+            assert!(details.contains(message), "{details}");
+            assert_eq!(*drops.borrow(), indices);
+        }
+    }
